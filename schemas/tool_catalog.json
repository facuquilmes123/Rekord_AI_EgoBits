  "shared_operations": [
    {
      "name": "collection.query",
      "description": "Filtrar toda la colección por título/artista, género, estrellas, sin reproducir, fecha AAAA-MM-DD y MyTags. Resultados paginados.",
      "parameters": {
        "query": "",
        "genre": "",
        "min_rating": null,
        "max_rating": null,
        "unplayed": false,
        "added_after": "",
        "tags": null,
        "tag_mode": "all",
        "sort_by_date": false,
        "limit": 50,
        "offset": 0
      },
      "read_only": true
    },
    {
      "name": "collection.tags",
      "description": "Listar MyTags con categoría e ID de la colección viva.",
      "parameters": {},
      "read_only": true
    },
    {
      "name": "collection.missing_files",
      "description": "Comprobar archivos por página; next_offset indica la página siguiente.",
      "parameters": {
        "limit": 100,
        "offset": 0
      },
      "read_only": true
    },
    {
      "name": "track.structure",
      "description": "Consultar hot cues, memory cues, loops, beatgrid y frases ANLZ existentes de un ID.",
      "parameters": {
        "track_id": "required"
      },
      "read_only": true
    },
    {
      "name": "set.preshow",
      "description": "Auditar una playlist o toda la colección por páginas antes del show.",
      "parameters": {
        "playlist": null,
        "limit": 100,
        "offset": 0
      },
      "read_only": true
    },
    {
      "name": "transition.phrase",
      "description": "Proponer mezcla 4/4 basada en Outro analizado y Hot Cue A, para dos IDs.",
      "parameters": {
        "from_id": "required",
        "to_id": "required",
        "bars": 16
      },
      "read_only": true
    },
    {
      "name": "set.plan_selection",
      "description": "Ordenar IDs obtenidos de filtros en modo bpm o energy; sólo propuesta.",
      "parameters": {
        "track_ids": "required",
        "count": 10,
        "mode": "bpm"
      },
      "read_only": true
    },
    {
      "name": "recommend.key_shift",
      "description": "Compatibilidad armónica con Key Shift optativo de 0, 1 o 2 semitonos.",
      "parameters": {
        "track_id": "required",
        "max_key_shift": 0,
        "count": 5
      },
      "read_only": true
    },
    {
      "name": "audio.measurement",
      "description": "Leer LUFS y energía estimada ya calculados offline para un ID.",
      "parameters": {
        "track_id": "required"
      },
      "read_only": true
    },
    {
      "name": "device.list",
      "description": "Detectar USB DeviceSQL presentes, sin modificar archivos.",
      "parameters": {},
      "read_only": true
    },
    {
      "name": "device.audit",
      "description": "Auditar un device_id obtenido de device.list: archivos, análisis y referencias huérfanas.",
      "parameters": {
        "device_id": "required",
        "limit": 100,
        "offset": 0
      },
      "read_only": true
    },
    {
      "name": "link.state",
      "description": "Consultar receptor o simulación Pro DJ Link; On-Air no certifica audio audible.",
